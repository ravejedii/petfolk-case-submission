# What never needs to reach the deployment.
#
# Everything the running app touches DOES ship: pipeline/, DATA/TRANSLATION/, DATA/INPUTS/,
# PROMPTS/, DATA/OUTPUTS/ and app/. The build adds pybin/ (its own interpreter) and
# app/web/dist (the built UI).

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Installed and built during the Vercel build, never uploaded.
node_modules/
app/node_modules/
app/web/dist/
pybin/
pydeps/

# Local-only working state.
app/server/uploads/
.env.local
nohup.out

# Reference material, not runtime.
*.pdf
PROMPTS_ARCHIVE/

# For a human cloning the repo, not for the deployment: the build installs the
# pipeline's dependencies into its own bundled interpreter (vercel-build.sh).
# Uploading these makes Vercel detect the repo as a Python app and look for a
# Python entrypoint, which this deployment does not have.
pytest.ini
tests/
