{
  "name": "petfolk-digest-app",
  "private": true,
  "version": "0.1.0",
  "description": "Monday Digest web app: React front-end + Node API serving the Python pipeline's output verbatim.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server\" \"npm run web\"",
    "server": "node server/index.js",
    "web": "vite web",
    "build": "vite build web",
    "start": "node server/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "verify:memory-loop-browser": "node scripts/verify-memory-loop-browser.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.62.1",
    "vite": "^6.3.5"
  }
}
